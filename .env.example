# Local development only: Main loads these values from .env when neither is supplied by the launcher.
HANTONG_GOOGLE_CLIENT_ID=
# Optional; if supplied, used only in the HTTPS token-exchange request body.
HANTONG_GOOGLE_CLIENT_SECRET=
# Optional Main-only relay base URL; origin or /api/v1/ (requests always go to /api/v1/), local HTTP only for 127.0.0.1.
HANTONG_RELAY_URL=https://hantong.leehan416.dev/api/v1/
